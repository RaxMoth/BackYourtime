source "https://rubygems.org"

# Pinning the toolchain so `pod install` works against Xcode 26's
# project format (objectVersion 70). The system Ruby 2.6 on macOS is
# too old to install these — use Homebrew Ruby (see tools/setup-ios-toolchain.sh).

ruby ">= 3.0.0"

gem "cocoapods", "~> 1.16"
gem "xcodeproj", "~> 1.27"
